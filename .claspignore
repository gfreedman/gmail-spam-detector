# Clasp ignore - only push the .gs files in sources.json, plus appsscript.json
#
# NOTE: clasp treats ANY .js under rootDir as Apps Script source and will try
# to upload it as a .gs file. A bare "*.js" pattern matches only top-level
# files, so tests/*.js and scripts/*.js need their own entries — adding
# scripts/patch_version.js broke a deploy with
# "ParseError: Unexpected token ILLEGAL ... file: scripts/patch_version.gs".
# Both the directory globs and "**/*.js" are listed deliberately.
archive/**
tests/**
scripts/**
docs/**
venv/**
__pycache__/**
.git/**
.github/**
.claude/**
*.md
*.py
*.js
**/*.js
*.json
*.txt

# .gs is denied too, so the "!" whitelist below is load-bearing rather than
# decorative. Without this line an unlisted root-level .gs matched NO pattern
# and was pushed — a file in nobody's manifest, linted by nothing, deployed
# anyway. Every source file must now be listed in sources.json AND whitelisted
# here; tests/test_patch_version.js asserts both directions.
*.gs
**/*.gs
.DS_Store
.clasp.json
.clasp.json.example
.claspignore
.gitignore
LICENSE

# Whitelist only these files.
#
# ROOTDIR-RELATIVE, not repo-relative. clasp crawls rootDir with fdir and
# filters these patterns against the crawl's relative paths, so the entry
# for src/Config.gs is "!Config.gs". Writing "!src/Config.gs" matches
# nothing, and with *.gs denied above that makes clasp push ZERO files —
# replacing the deployed script with nothing. Verified against clasp 3.3.0's
# own micromatch; tests/test_patch_version.js asserts it both ways.
!Config.gs
!Clickbait.gs
!Patterns.gs
!Inbox.gs
!SpamFolder.gs
!Cleanup.gs
!Thread.gs
!Signals.gs
!Verdict.gs
!Disposition.gs
!Labels.gs
!Text.gs
!LinkGraph.gs
!Log.gs
!Setup.gs
!Domains.gs
!State.gs
!Maintenance.gs
!Intelligence.gs
!Flush.gs
!Debug.gs
!appsscript.json
